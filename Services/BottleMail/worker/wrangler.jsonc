{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bottlemail",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bottlemail-db",
      "database_id": "7dd1b451-ad05-49a2-a3a3-fabaa5d8a606"
    }
  ],
  "vars": {
    "SENDER_USERNAME": "sender",
    "ACTIVATION_TTL_MINUTES": "30",
    "SENDER_PASSWORD_ITERATIONS": "10000"
  }
}
