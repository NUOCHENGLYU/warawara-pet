# Bottle Mail — environment template (NEVER commit real values)
#
# Local development only: copy this file to `.dev.vars` and fill it in.
# Production values are set with `npx wrangler secret put <NAME>`
# (see docs/SETUP.md) — they never appear in any file.
#
# Generate SENDER_PASSWORD_HASH / SENDER_PASSWORD_SALT locally with:
#   node scripts/hash-password.mjs
# (reads the password from stdin, never from the command line)

SESSION_SECRET=replace-with-64-random-hex-chars
SENDER_PASSWORD_SALT=replace-with-hex-salt-from-hash-password-script
SENDER_PASSWORD_HASH=replace-with-hex-hash-from-hash-password-script
