{
  "version": 1,
  "layout": {
    "canvas": [1024, 1024],
    "anchor": [0.5, 0.5],
    "bodyBounds": [[0.10, 0.09], [0.80, 0.82]]
  },
  "animations": {
    "idle":     { "frames": ["warawara_neutral.png", "warawara_neutral.png"], "frameDuration": 0.6, "loop": true },
    "hop":      { "frames": ["warawara_neutral.png", "warawara_neutral.png", "warawara_neutral.png"], "frameDuration": 0.08, "loop": false },
    "float":    { "frames": ["warawara_neutral.png", "warawara_neutral.png", "warawara_neutral.png"], "frameDuration": 0.15, "loop": true },
    "curious":  { "frames": ["warawara_neutral.png"], "frameDuration": 0.1, "loop": false },
    "clicked":  { "frames": ["warawara_neutral.png"], "frameDuration": 0.1, "loop": false },
    "dragged":  { "frames": ["warawara_neutral.png"], "frameDuration": 0.1, "loop": false },
    "settling": { "frames": ["warawara_neutral.png"], "frameDuration": 0.1, "loop": false },
    "sleepy":   { "frames": ["warawara_neutral.png"], "frameDuration": 0.1, "loop": false },
    "sleeping": { "frames": ["warawara_neutral.png"], "frameDuration": 0.1, "loop": false },
    "wake":     { "frames": ["warawara_neutral.png"], "frameDuration": 0.1, "loop": false }
  }
}
